{
  "name": "@canvas/server",
  "version": "0.1.0",
  "private": true,
  "description": "Stateful WebSocket collaboration server with Redis backplane and PostgreSQL snapshots.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/infrastructure/postgres/migrate.ts"
  },
  "dependencies": {
    "@canvas/shared": "^0.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lib0": "^0.2.119",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "y-websocket": "^3.1.0"
  }
}
