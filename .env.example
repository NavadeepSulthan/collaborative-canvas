# Copy to apps/server/.env (loaded automatically on start). Every value has a safe development default.

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Unique per replica; defaults to hostname + random suffix.
# NODE_ID=node-a
ALLOWED_ORIGINS=http://localhost:5173
# Required in production (min 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Issues demo tokens from POST /api/dev-token. Never enable on a public deployment without real auth.
AUTH_DEV_TOKENS=true

# --- Infrastructure (leave unset to use in-memory adapters) ---
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgres://canvas:canvas@localhost:5432/canvas

# --- Tuning ---
PERSIST_DEBOUNCE_MS=250
COMPACTION_THRESHOLD=50
ROOM_IDLE_TTL_MS=30000
# Nodes gossip state vectors so a dropped Pub/Sub message is repaired within this window.
ANTI_ENTROPY_INTERVAL_MS=15000
# Room fan-out batching window. Idle rooms send immediately; busy rooms at most every N ms.
BROADCAST_INTERVAL_MS=25
# Must fit a full document diff (clients send everything they have on reconnect).
MAX_MESSAGE_BYTES=33554432

# --- Observability ---
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Web (Vite reads VITE_* at build time) ---
# VITE_COLLAB_HTTP_URL=http://localhost:4000
# VITE_COLLAB_WS_URL=ws://localhost:4000/collab
